# Copy this file to .env and fill in real values. Never commit .env.
# Add every new variable name here (without the real value).

# Local Postgres in Docker (docker compose). Defaults work for local development.
POSTGRES_USER=lab
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=lab_assistant

# Database connection string when running code outside Docker.
# Local: postgresql://lab:change_me_local_only@localhost:5432/lab_assistant
# Hosted (Neon): copy it from the Neon dashboard. Never paste it anywhere else.
DATABASE_URL=

# Ollama (local LLM, runs on your own machine)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=

# Monday email (Gmail)
GMAIL_SENDER=
GMAIL_APP_PASSWORD=
PROFESSOR_EMAIL=

# Google Drive (ebook library)
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_APPLICATION_CREDENTIALS=
